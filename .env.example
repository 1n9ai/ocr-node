# 1n9 OCR — read documents, check them against your rules, get alerted. Copy to .env and fill in. Never commit .env.
#
# Only CENTRAL_URL, LICENSE_KEY and NODE_PASSWORD are needed. The AI connection is easier to set up in the browser
# (first-run setup / Settings); the LLM values below are only used as defaults the first time the app starts.
# Everything is then stored encrypted in data/node.db.

# Central address and the license key you received
# Must be https:// — plain http is only allowed for localhost, a docker service name or a private LAN address
CENTRAL_URL=https://central.1n9ai.com
LICENSE_KEY=
# (optional) trust only the CA in this file for central (certificate pinning)
# CENTRAL_CA_FILE=/app/data/central-ca.pem

# Web login (Basic Auth). The documents you read can be confidential — always set a password.
NODE_USER=admin
NODE_PASSWORD=

# Who can reach the app: 127.0.0.1 = this machine only · 0.0.0.0 = whole network
NODE_BIND=127.0.0.1
OCR_PORT=8083

# Encryption key for stored API keys. Empty = generated into data/secret.key (back it up with node.db)
# NODE_SECRET_KEY=

# Largest file accepted (MB) and how many documents are read at the same time
# MAX_OCR_MB=20
# OCR_CONCURRENCY=3

# ── Optional first-start defaults (you can leave all of these empty) ──
# LLM — reads the images and PDFs, so it must be a model that can read images. google | openai_compatible | ollama
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
